# mem0 本地增强方案 — 环境变量配置
# 复制此文件为 .env 并填入你的实际值

# mem0 安装目录（默认 ~/.mem0）
MEM0_DIR=~/.mem0

# mem0 配置文件路径（主配置）
MEM0_CONFIG=~/.mem0/config_local.json

# 备用配置文件路径（LLM 兜底）
# MEM0_FALLBACK_CONFIG=~/.mem0/config_ollama.json

# Chroma 向量数据库路径
MEM0_CHROMA_PATH=~/.mem0/chroma_db

# history.db 路径
MEM0_HISTORY_DB=~/.mem0/history.db

# 用户标识（任意字符串，用于 mem0 user_id）
MEM0_USER_ID=default-user

# API 配置（如果你的 LLM 使用 API）
# LLM_API_KEY=YOUR_API_KEY_HERE
# LLM_API_BASE_URL=http://your-api-host:port