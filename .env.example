# mem0 本地增强方案 — 环境变量配置
# setup.sh 会复制到 ~/.mem0/.env；也可在 shell 中 export

# mem0 安装目录（默认 ~/.mem0）
MEM0_DIR=~/.mem0

# mem0 配置文件路径
MEM0_CONFIG=~/.mem0/config_local.json
MEM0_FALLBACK_CONFIG=~/.mem0/config_ollama.json

# 存储路径（默认均在 MEM0_DIR 下，可单独覆盖）
MEM0_CHROMA_PATH=~/.mem0/chroma_db
MEM0_HISTORY_DB=~/.mem0/history.db
MEM0_ACTIVE_DB=~/.mem0/active_memories.db
MEM0_DELETED_DB=~/.mem0/deleted_archive.db

# 项目别名映射（目录名 → project 标识）
# MEM0_PROJECT_ALIASES=~/.mem0/project_aliases.json

# 用户标识（mem0 user_id；hybrid_search 亦读 MEM0_DEFAULT_USER_ID）
MEM0_USER_ID=default-user

# 混合检索调参（设 0 关闭对应截断）
MEM0_VECTOR_REL_MARGIN=0.10
MEM0_KW_REL_RATIO=0.25

# API 配置（若 LLM 使用远程 API，在 config_local.json 中填写亦可）
# LLM_API_KEY=YOUR_API_KEY_HERE
# LLM_API_BASE_URL=http://your-api-host:port
